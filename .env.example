# Netfish stack variables. ALL OPTIONAL: the easy way is to leave these empty and
# set everything in the app (first-run setup, then Settings → Connections).
# Use them if you'd rather configure through Portainer; the app shows them as
# "From the stack", and anything saved in the app takes over.
# For local development against real services, copy to server/.env.
#
# Where to find API keys:
#   Seerr     → Settings → General → API Key
#   Radarr    → Settings → General → Security → API Key
#   Sonarr    → Settings → General → Security → API Key
#   Bazarr    → Settings → General → Security → API Key
#   Jellyfin  → Dashboard → API Keys → +   (optional)
#   MDBList   → mdblist.com → Preferences → API key (free; Letterboxd/Metacritic scores)
#
# host.docker.internal = the Pi itself, as seen from inside the container.

# The image GitHub builds; netfish:latest if you built it on the Pi yourself.
NETFISH_IMAGE=ghcr.io/ravifrancesco/netfish:latest
TZ=Etc/UTC

JELLYFIN_URL=
JELLYFIN_API_KEY=
SEERR_URL=
SEERR_API_KEY=
RADARR_URL=
RADARR_API_KEY=
SONARR_URL=
SONARR_API_KEY=
BAZARR_URL=
BAZARR_API_KEY=
QBITTORRENT_URL=
QBITTORRENT_USERNAME=
QBITTORRENT_PASSWORD=
MDBLIST_API_KEY=

MANUAL_GRABS=all
METADATA_LANGUAGE=en
